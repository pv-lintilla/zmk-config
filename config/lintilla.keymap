#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bt_sel_0: bt_select_0 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 0>, <&bt_clr 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_1: bt_select_1 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 1>, <&bt_clr 1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_2: bt_select_2 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 2>, <&bt_clr 2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_3: bt_select_3 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 3>, <&bt_clr 3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_4: bt_select_4 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 4>, <&bt_clr 4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ht_hyper: hold_tap_hyper {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <70>;
        };

        hrm_left: home_row_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <36 37 38 39 40 41 8 31 8 9 11 12 13 20 21 22 23 24 25 31 32 33 34 35 41 10 1>;
            flavor = "balanced";
        };

        hrm_right: home_row_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <0>;
            hold-trigger-key-positions = <39 41 40 0 2 3 4 5 6 7 14 15 16 17 18 19 26 27 28 29 30 36 37 38>;
            flavor = "balanced";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Function {
            if-layers = <1 4>;
            then-layer = <3>;
        };
    };

    macros {
        bt_sel: bt_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };

        bt_clr: bt_clear {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &bt BT_CLR>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <21 22 23>;
            layers = <0>;
        };

        open_parantheses {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <18 19>;
            layers = <0>;
        };

        right_paranthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <29 30>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 32>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <6 7>;
            layers = <0>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <8 9>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <27 28>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <27 29>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        screenshot {
            bindings = <&kp LG(LA(C))>;
            key-positions = <27 29 28>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <16 17 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphas {
            bindings = <
                                &kp LG(TAB)                                                                                                                                                                                                 &kp ENTER
&kp TAB                         &kp Q              &kp W             &kp E             &kp R                   &kp T                                                      &kp Y  &kp U                &kp I              &kp O              &kp P                       &kp MINUS
&ht_hyper LS(LA(LC(LGUI))) ESC  &hrm_left LCTRL A  &hrm_left LALT S  &hrm_left LGUI D  &hrm_left LEFT_SHIFT F  &kp G                                                      &kp H  &hrm_right RSHIFT J  &hrm_right RGUI K  &hrm_right RALT L  &hrm_right RCTRL SEMICOLON  &kp SINGLE_QUOTE
                                &kp Z              &kp X             &kp C             &kp V                   &kp B                                                      &kp N  &kp M                &kp COMMA          &hm RALT PERIOD    &kp SLASH
                                                                                                               &mo 1  &kp SPACE  &kp RIGHT_SHIFT  &mo 2  &lt 3 BACKSPACE  &mo 4
            >;

            label = "qwert";
        };

        LT_MAC {
            bindings = <
           &trans                                                                                                                                                                                                                                &trans
&trans     &kp LA(LS(NUMBER_1))  &kp LA(LS(NUMBER_2))  &kp LA(LS(NUMBER_3))  &kp LA(LS(NUMBER_4))  &kp LA(LS(NUMBER_5))                                  &kp LA(LS(NUMBER_6))  &kp LA(LS(NUMBER_7))  &kp LA(LS(NUMBER_8))  &kp LA(LS(NUMBER_9))  &kp LA(LS(EQUAL))      &trans
&kp TILDE  &kp LA(NUMBER_1)      &kp LA(NUMBER_2)      &kp LA(NUMBER_3)      &kp LA(NUMBER_4)      &kp LA(NUMBER_5)                                      &kp LA(NUMBER_6)      &kp LA(NUMBER_7)      &kp LA(NUMBER_8)      &kp LA(NUMBER_9)      &kp LA(EQUAL)          &trans
           &kp EXCLAMATION       &kp AT_SIGN           &kp POUND             &kp DOLLAR            &kp PERCENT                                           &kp CARET             &kp AMPERSAND         &kp ASTERISK          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
                                                                                                   &trans                &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbols {
            bindings = <
        &trans                                                                                                                                                              &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN       &kp POUND         &kp DOLLAR         &kp PERCENT                                 &kp CARET      &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp SLASH  &kp ASTERISK
&trans  &kp LESS_THAN    &kp GREATER_THAN  &kp EXCLAMATION   &kp EQUAL          &kp PIPE                                    &kp AMPERSAND  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS  &kp PLUS
        &kp SLASH        &kp BACKSLASH     &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp GRAVE                                   &kp ASTERISK   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp TILDE
                                                                                &trans       &trans  &mo 3  &trans  &trans  &kp KP_N0
            >;
        };

        fn {
            bindings = <
        &trans                                                                                                           &trans
&trans  &trans     &trans    &trans    &trans     &trans                                 &trans  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                                 &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
        &trans     &trans    &trans    &trans     &trans                                 &trans  &kp F1  &kp F2  &kp F3  &kp F12
                                                  &trans  &trans  &trans  &mo 3  &trans  &trans
            >;
        };

        navigation {
            bindings = <
        &trans                                                                                                                                                                         &trans
&trans  &bt_sel_0         &bt_sel_1       &bt_sel_2     &bt_sel_3     &bt_sel_4                                         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans     &trans
&trans  &kp LCTRL         &kp LALT        &kp LGUI      &kp LSHFT     &trans                                            &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp ENTER  &trans
        &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT                                        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
                                                                      &mkp LCLK   &mkp MCLK  &mkp RCLK  &trans  &trans  &trans
            >;
        };
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4 filetype=dts
