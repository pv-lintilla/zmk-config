#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        bt_sel_0: bt_select_0 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 0>, <&bt_clr 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_1: bt_select_1 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 1>, <&bt_clr 1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_2: bt_select_2 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 2>, <&bt_clr 2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_3: bt_select_3 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 3>, <&bt_clr 3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_sel_4: bt_select_4 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&bt_sel 4>, <&bt_clr 4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ht_hyper: hold_tap_hyper {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <70>;
        };

        hrm_left: home_row_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <60>;
            hold-trigger-key-positions = <39 40 41 8 31 8 9 11 12 13 20 21 22 23 24 25 31 32 33 34 35 41 10 1 36 37 38>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        hrm_right: home_row_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <60>;
            hold-trigger-key-positions = <0 2 3 4 5 6 7 14 15 16 17 18 19 26 27 28 29 30 36 37 38 39 40 41>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        sft_semicolon: sft_semicolon {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            label = "SFT_SEMICOLON";
        };

        mm_mo3: mm_mo3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_MO3";
            bindings = <&mo 3>, <&kp LEFT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mm_space: mm_space {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SPACE";
            bindings = <&lt 2 SPACE>, <&kp LEFT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mm_app_switch: mm_app_switch {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_APP_SWITCH";
            bindings = <&none>, <&kp LEFT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mm_symbols: mm_symbols {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SYMBOLS";
            bindings = <&mo 1>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mm_backspace: mm_backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BACKSPACE";
            bindings = <&kp BACKSPACE>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mm_navigation: mm_navigation {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_NAVIGATION";
            bindings = <&mo 5>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        td_app_switch: td_app_switch {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_APP_SWITCH";
            #binding-cells = <0>;
            bindings = <&kp LG(TAB)>, <&start_app_switch>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        bt_sel: bt_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };

        bt_clr: bt_clear {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &bt BT_CLR>;
        };

        print_todo_pv: print_todo_pv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH &kp FSLH &kp SPACE &kp LS(T) &kp LS(O) &kp LS(D) &kp LS(O) &kp SPACE &kp LS(P) &kp LS(V) &kp COLON &kp SPACE>;
            label = "PRINT_TODO_PV";
        };

        constant: constant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp U &kp B &kp L &kp I &kp C &kp SPACE &kp S &kp T &kp A &kp T &kp I &kp C &kp SPACE &kp F &kp I &kp N &kp A &kp L &kp SPACE>;
            label = "CONSTANT";
        };

        lambda: lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GT &kp SPACE>;
            label = "LAMBDA";
        };

        full_lambda: full_lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LPAR &kp RPAR &kp SPACE &kp MINUS &kp GT &kp SPACE &kp LBRC &kp RBRC>,
                <&macro_wait_time 30>,
                <&kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT_ARROW &kp LEFT_ARROW>;

            label = "FULL_LAMBDA";
        };

        full_brackets: full_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LBKT &kp RBKT>,
                <&macro_wait_time 30>,
                <&kp LEFT_ARROW>;

            label = "FULL_BRACKETS";
        };

        full_paranthesis: full_paranthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LPAR &kp RPAR>,
                <&macro_wait_time 30>,
                <&kp LEFT_ARROW>;

            label = "FULL_PARANTHESIS";
        };

        full_braces: full_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LBRC &kp RBRC>,
                <&macro_wait_time 30>,
                <&kp LEFT_ARROW>;

            label = "FULL_BRACES";
        };

        full_greater_less: full_greater_less {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT>, <&macro_wait_time 30>, <&kp LEFT_ARROW>;

            label = "FULL_GREATER_LESS";
        };

        javadoc: javadoc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH &kp STAR &kp STAR &kp RET>;
            label = "JAVADOC";
        };

        space_to_0: space_to_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &to 0>;
            label = "SPACE_TO_0";
        };

        start_app_switch: enter_app_switch_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LGUI &kp TAB &to 5>;
            label = "ENTER_APP_SWITCH_WINDOW";
        };

        end_app_switch: end_app_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LGUI &to 0>;
            label = "END_APP_SWITCH";
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <27 28>;
            require-prior-idle-ms = <200>;
            layers = <0 6>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <27 29>;
            require-prior-idle-ms = <200>;
            layers = <0 6>;
        };

        screenshot {
            bindings = <&kp LG(LA(C))>;
            key-positions = <27 29 28>;
            require-prior-idle-ms = <200>;
            layers = <0 6>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <33 34>;
            layers = <0 6>;
        };

        undo {
            bindings = <&kp LG(Z)>;
            key-positions = <16 17 18>;
            layers = <0 3 4 5 6>;
        };

        redo {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <21 22 23>;
            layers = <0 3 4 5 6>;
        };

        lambda {
            bindings = <&to 6>;
            key-positions = <4 5 6>;
            layers = <0 3 4 5 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphas_mac {
            bindings = <
                                &kp TAB                                                                                                                                                                                           &kp ENTER
&ht_hyper LS(LA(LC(LGUI))) ESC  &kp Q              &kp W             &kp E             &kp R                   &kp T                                            &kp Y  &kp U                &kp I              &kp O              &kp P          &kp MINUS
&kp LSHFT                       &hrm_left LCTRL A  &hrm_left LALT S  &hrm_left LGUI D  &hrm_left LEFT_SHIFT F  &kp G                                            &kp H  &hrm_right RSHIFT J  &hrm_right RGUI K  &hrm_right RALT L  &kp SEMICOLON  &sft_semicolon RSHFT SINGLE_QUOTE
                                &kp Z              &kp X             &kp C             &kp V                   &kp B                                            &kp N  &kp M                &kp COMMA          &kp PERIOD         &kp SLASH
                                                                                                               &mo 3  &lt 2 SPACE  &mo 1  &mo 1  &kp BACKSPACE  &mo 5
            >;

            label = "qwert";
        };

        symbols {
            bindings = <
           &trans                                                                                                                                            &trans
&kp GRAVE  &kp TILDE  &kp AT         &kp POUND        &kp DOLLAR  &kp PERCENT                                   &kp CARET   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_DIVIDE  &kp LA(KP_MULTIPLY)
&trans     &kp SLASH  &kp BACKSLASH  &kp EXCLAMATION  &kp EQUAL   &kp ASTERISK                                  &trans      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS   &kp LS(KP_PLUS)
           &kp MINUS  &kp PLUS       &kp AMPERSAND    &kp PIPE    &kp PLUS                                      &kp KP_DOT  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0
                                                                  &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            bindings = <
       &none                                                                                                        &none
&none  &none      &none     &none     &none      &none                               &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none                               &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
       &none      &none     &none     &none      &none                               &none  &kp F1  &kp F2  &kp F3  &kp F12
                                                 &none  &trans  &none  &none  &mo 7  &none
            >;
        };

        LT_MAC {
            bindings = <
        &trans                                                                                                                                                                                                                                &trans
&trans  &kp LA(LS(NUMBER_1))  &kp LA(LS(NUMBER_2))  &kp LA(LS(NUMBER_3))  &kp LA(LS(NUMBER_4))  &kp LA(LS(NUMBER_5))                                  &kp LA(LS(NUMBER_6))  &kp LA(LS(NUMBER_7))  &kp LA(LS(NUMBER_8))  &kp LA(LS(NUMBER_9))  &kp LA(LS(EQUAL))  &trans
&trans  &kp LA(NUMBER_1)      &kp LA(NUMBER_2)      &kp LA(NUMBER_3)      &kp LA(NUMBER_4)      &kp LA(NUMBER_5)                                      &kp LA(NUMBER_6)      &kp LA(NUMBER_7)      &kp LA(NUMBER_8)      &kp LA(NUMBER_9)      &kp LA(EQUAL)      &trans
        &trans                &trans                &javadoc              &print_todo_pv        &trans                                                &trans                &lambda               &full_lambda          &trans                &trans
                                                                                                &trans                &trans  &trans  &trans  &trans  &trans
            >;
        };

        num {
            bindings = <
        &trans                                                                                                                           &trans
&trans  &trans     &trans    &trans    &trans     &trans                                  &trans        &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_DIVIDE  &kp KP_MULTIPLY
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                                  &kp KP_EQUAL  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS   &kp KP_PLUS
        &trans     &trans    &trans    &trans     &trans                                  &kp KP_DOT    &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0
                                                  &mo 7   &trans  &trans  &trans  &trans  &trans
            >;
        };

        navigation {
            bindings = <
        &trans                                                                                                                                                                           &end_app_switch
&trans  &trans            &trans          &kp LG(MINUS)  &kp LG(EQUAL)  &trans                                            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans           &kp HOME
&trans  &kp LCTRL         &kp LALT        &kp LGUI       &kp LSHFT      &trans                                            &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp ENTER        &kp END
        &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT                                        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
                                                                        &mkp LCLK   &mkp MCLK  &mkp RCLK  &trans  &trans  &trans
            >;
        };

        caps {
            bindings = <
        &constant                                                                                                                                                                                                                            &trans
&trans  &kp LS(Q)              &kp LS(W)             &kp LS(E)             &kp LS(R)               &kp LS(T)                                               &kp LS(Y)  &kp LS(U)                &kp LS(I)              &kp LS(O)              &kp LS(P)                      &trans
&to 0   &hrm_left LCTRL LS(A)  &hrm_left LALT LS(S)  &hrm_left LGUI LS(D)  &hrm_left LSHIFT LS(F)  &kp LS(G)                                               &kp LS(H)  &hrm_right RSHIFT LS(J)  &hrm_right RGUI LS(K)  &hrm_right RALT LS(L)  &hrm_right RCTRL SINGLE_QUOTE  &trans
        &kp LS(Z)              &kp LS(X)             &kp LS(C)             &kp LS(V)               &kp LS(B)                                               &kp LS(N)  &kp LS(M)                &trans                 &trans                 &trans
                                                                                                   &kp UNDERSCORE  &kp SPACE  &space_to_0  &trans  &trans  &trans
            >;
        };

        bt {
            bindings = <
        &trans                                                                                                                                &bt BT_CLR
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans        &trans        &trans        &trans        &trans                                        &trans  &trans  &trans  &trans  &trans      &trans
        &trans        &trans        &trans        &trans        &trans                                        &trans  &trans  &trans  &trans  &trans
                                                                &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4 filetype=dts
